# App
APP_NAME=Diploma AI Assistant API
APP_VERSION=3.4.0
APP_ENV=dev

# OpenAI direct
OPENAI_API_KEY=
OPENAI_BASE_URL=

# OpenRouter / OpenAI-compatible API
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# LLM
OPENAI_MODEL=openrouter/free
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Production operations
ADMIN_TOKEN=change-me-admin-token
INTERNAL_TOKEN=change-me-internal-token
MODERATION_OPENAI_ENABLED=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diploma

# Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CACHE_DIR=.cache/embeddings

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
EMBEDDING_DIM=768

# RAG Block 5.3
RAG_DATA_DIR=data
RAG_COLLECTION=rag_block_03
RAG_PRODUCTION_COLLECTION=corporate_rag
RAG_DOCSTORE_PATH=.cache/rag/docstore.json
RAG_BAREMETAL_COLLECTION=rag_block_03_baremetal
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_TOP_K=3
RAG_MIN_SCORE=0.82
RAG_CHUNKING_STRATEGY=recursive
RAG_RETRIEVAL_TOP_K=10
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_N=5
RAG_CONDENSE_ENABLED=true
RAG_MAX_SOURCES=5

# CORS
# Р”Р»СЏ СѓС‡РµР±РЅРѕРіРѕ РїСЂРѕРµРєС‚Р° РѕСЃС‚Р°РІР»СЏРµРј "*"
CORS_ORIGINS=["*"]
# Chat history storage
CHAT_REPOSITORY=json
CHAT_STORAGE_DIR=./var/chats
CHAT_CONTEXT_STRATEGY=sliding
CHAT_CONTEXT_WINDOW=10

# Telegram bot
BOT_TOKEN=
BACKEND_URL=http://127.0.0.1:8000
BOT_ADMIN_IDS=[]
