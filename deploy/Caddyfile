{
	servers {
		timeouts {
			read_header 10s
			read_body 2m
			# Streaming responses are bounded by app concurrency, not a proxy
			# write deadline that could terminate a valid SSE connection.
			write 0s
			idle 5m
		}
	}
}

{$PUBLIC_DOMAIN:localhost} {
	request_body {
		max_size {$PROXY_MAX_REQUEST_BODY:12MB}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	reverse_proxy app:8000 {
		# Disable response buffering so SSE events are flushed immediately.
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 180s
			keepalive 30s
		}
	}
}
