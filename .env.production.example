# Copy to .env.production, replace every change-me value, and keep that file
# outside Git. Pass it to Compose with --env-file .env.production.
PUBLIC_ENV_FILE=.env.production
APP_ENV=public
PUBLIC_DOMAIN=demo.example.com
PUBLIC_PROXY_SUBNET=172.31.250.0/24
PUBLIC_PROXY_IP=172.31.250.10
TRUSTED_PROXY_CIDRS=172.31.250.10/32

ADMIN_TOKEN=change-me-long-random-admin-token
INTERNAL_TOKEN=change-me-long-random-internal-token
POSTGRES_DB=diploma
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-long-random-database-password
DATABASE_URL=postgresql://postgres:change-me-long-random-database-password@postgres:5432/diploma
QDRANT_API_KEY=change-me-long-random-qdrant-key

# Configure exactly one supported provider credential.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=change-me-provider-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Telegram integration. Leave blank to keep the bot disabled.
BOT_TOKEN=
BOT_ADMIN_IDS=[]

CORS_ORIGINS=["https://demo.example.com"]
PROXY_MAX_REQUEST_BODY=12MB
PROXY_MEMORY_LIMIT=256m
PROXY_CPU_LIMIT=0.5
